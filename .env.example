# Só é necessário para rodar com autenticação ligada (AUTH_ENABLED=true) ou em produção.
# O Spring Boot lê VARIÁVEIS DE AMBIENTE (não carrega .env sozinho): exporte-as no shell ou no serviço.
# NUNCA commite segredos. Gere um com:  openssl rand -base64 48   (ou no PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })))
AUTH_ENABLED=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Opcionais
CORS_ORIGINS=
# URL JDBC. Padrão: SQLite local (jdbc:sqlite:./bom.db?foreign_keys=on&journal_mode=WAL&busy_timeout=5000).
# PostgreSQL: jdbc:postgresql://host:5432/banco  (com DATABASE_USER e DATABASE_PASSWORD)
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
